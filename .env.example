# ==============================================================================
# XSignOn Environment Template (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# Site Environment & Base URL
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Transactional Email & Messaging (Epics E04, E05, E06)
# ------------------------------------------------------------------------------
# Server-only. API key for your transactional email provider (Resend, SendGrid, Postmark, AWS SES, etc.):
# Leave empty in local development to use terminal console fallback / staging isolation.
EMAIL_API_KEY=

# Internal recipient email where contact form submissions will be delivered:
CONTACT_NOTIFICATION_EMAIL=info@xsignon.com

# Destination email for development/staging environments (prevents sending to real customers):
STAGING_NOTIFICATION_EMAIL=staging-inbox@xsignon.test

# ------------------------------------------------------------------------------
# 2. Automated Maintenance & Webhook Security
# ------------------------------------------------------------------------------
# Server-only. Shared secret to authorize automated cleanup jobs at /api/cron/cleanup:
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Server-only. Shared secret to verify inbound webhook signatures at /api/webhooks/email:
WEBHOOK_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 3. Headless CMS (Sanity.io)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging

# Server-only. Create in sanity.io/manage > API > Tokens with Viewer role:
SANITY_API_READ_TOKEN=

# Server-only. Shared secret for Sanity webhook revalidation at /api/revalidate:
SANITY_REVALIDATE_SECRET=

# ------------------------------------------------------------------------------
# 4. Error Monitoring (Sentry)
# ------------------------------------------------------------------------------
# Public DSN. Leave empty to turn reporting off:
NEXT_PUBLIC_SENTRY_DSN=

# Server-only. Secret header value for /api/monitoring-test:
MONITORING_TEST_SECRET=
