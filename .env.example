# Copy to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
# Server-only. Create in sanity.io/manage > API > Tokens with the Viewer role. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server-only. Shared secret for the Sanity webhook to /api/revalidate. Use a long random value, for example: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
# Error monitoring (S-18). The DSN is public by design; leave empty to turn reporting off.
NEXT_PUBLIC_SENTRY_DSN=
# Server-only. Lets the owner force a test error: curl -H "x-monitoring-secret: <value>" <site>/api/monitoring-test
MONITORING_TEST_SECRET=
