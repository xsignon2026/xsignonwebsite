# ==============================================================================
# XSignOn Environment Template (.env.example)
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# Site Environment & Base URL
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Enquiries and email (contact form, T-055 to T-058)
# ------------------------------------------------------------------------------
# Private database for enquiries. Pooled connection string with sslmode=require (for example Neon). Server-only.
# Create the tables with: npm run db:migrate
DATABASE_URL=
# Server-only. At least 32 random characters. Keys the hashes used for rate limiting: openssl rand -hex 32
ENQUIRY_HASH_SECRET=
# Email delivery over Resend. Without all three, enquiries are saved and wait; nothing is lost.
RESEND_API_KEY=
# The sender, on a domain with SPF, DKIM and DMARC. Example: XSignOn <hello@mail.example.com>
EMAIL_FROM=
# Where enquiries are emailed. A TEST inbox on staging and previews, the real shared inbox on Production only.
ENQUIRY_INBOX=
# The owner's delivery page (/admin/enquiries). Server-only. Password at least 16 characters, or the page stays off.
ADMIN_USER=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Automated Maintenance & Webhook Security
# ------------------------------------------------------------------------------
# Server-only. At least 16 random characters. Lets the scheduler call /api/cron/deliveries:
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Server-only. Shared secret to verify inbound webhook signatures at /api/webhooks/email:
WEBHOOK_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 3. Headless CMS (Sanity.io)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging

# Server-only. Create in sanity.io/manage > API > Tokens with Viewer role:
SANITY_API_READ_TOKEN=

# Server-only. Shared secret for Sanity webhook revalidation at /api/revalidate:
SANITY_REVALIDATE_SECRET=

# ------------------------------------------------------------------------------
# 4. Error Monitoring (Sentry)
# ------------------------------------------------------------------------------
# Public DSN. Leave empty to turn reporting off:
NEXT_PUBLIC_SENTRY_DSN=

# Server-only. Secret header value for /api/monitoring-test:
MONITORING_TEST_SECRET=
