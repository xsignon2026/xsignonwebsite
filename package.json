{
  "name": "xsignon-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "dev": "node scripts/build-css.mjs && next dev --webpack",
    "build": "node scripts/build-css.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.10.0",
    "next": "16.4.4",
    "next-sanity": "13.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.22.0",
    "server-only": "0.0.1",
    "styled-components": "6.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.9",
    "npm": ">=10"
  }
}
